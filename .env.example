# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
   
# Optional: Use your preferred model
OPENAI_MODEL=gpt-4o

# Optional public web search; requires both values to enable
SERPER_API_KEY=your_serper_api_key_here
AAMAD_ENABLE_WEB_RESEARCH=false

# Local frontend origin allowed by the API
FRONTEND_ORIGIN=http://localhost:5173
   
# AAMAD runtime target (default for this course)
AAMAD_TARGET_RUNTIME=crewai
   
# Application Configuration
APP_NAME=Recruitment Assistant
APP_ENV=development
   
# CrewAI Configuration (if needed)
CREWAI_TELEMETRY_OPT_OUT=true